# Supabase (프로젝트 설정 → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 보드가 하나면 생략할 수 있습니다. 여러 보드가 있으면 사용할 보드 UUID를 지정하세요.
APP_BOARD_ID=

# 장소 추출용 LLM: gemini(기본, 무료 키) 또는 anthropic
LLM_PROVIDER=gemini
# Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic API (LLM_PROVIDER=anthropic일 때만)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5

# 카카오 디벨로퍼스 (앱 키)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 선택: Meta oEmbed (승인받은 경우에만)
INSTAGRAM_OEMBED_TOKEN=
INSTAGRAM_OEMBED_VERSION=v21.0

# 배포 주소 (단축어에 돌려줄 확인 페이지 링크용)
APP_BASE_URL=https://your-app.vercel.app
