# Supabase (프로젝트 설정 → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web Push: npm run push:keys -- https://배포주소 로 한 번 생성한 뒤 Vercel에도 같은 값을 설정하세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 장소 추출용 LLM: gemini(기본, 무료 키) 또는 anthropic
LLM_PROVIDER=gemini
# Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic API (LLM_PROVIDER=anthropic일 때만)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-5-5

# 카카오 디벨로퍼스 (앱 키). 카카오 로그인도 같은 REST API 키를 사용합니다.
KAKAO_REST_API_KEY=
# 선택: 카카오 로그인 보안의 Client Secret을 켠 경우
KAKAO_LOGIN_CLIENT_SECRET=
# 구글 로그인 (Google Cloud → OAuth 2.0 클라이언트 ID, 웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 선택: Meta oEmbed (승인받은 경우에만)
INSTAGRAM_OEMBED_TOKEN=
INSTAGRAM_OEMBED_VERSION=v21.0

# 배포 주소 (단축어에 돌려줄 확인 페이지 링크용)
APP_BASE_URL=https://your-app.vercel.app

# Scheduled push retries; same value as Supabase Vault datemap_cron_secret
CRON_SECRET=
